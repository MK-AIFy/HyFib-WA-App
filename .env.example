# Global
NODE_ENV=development
LOG_LEVEL=info
PLATFORM_BASE_URL=http://localhost:8080
ALLOWED_WEBHOOK_CIDRS=

# API Gateway
API_GATEWAY_PORT=8080
WEBHOOK_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me
WEBHOOK_INGESTOR_URL=http://webhook-ingestor:8093
META_ADAPTER_URL=http://meta-adapter:8092
AI_INTELLIGENCE_URL=http://ai-intelligence-service:8095

# WhatsApp
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_BUSINESS_PORTFOLIO_ID=
WHATSAPP_REGISTER_PIN=

# Service Ports
AUTH_SERVICE_PORT=8082
TENANT_SERVICE_PORT=8083
CONTACT_SERVICE_PORT=8084
CONVERSATION_SERVICE_PORT=8085
CAMPAIGN_SERVICE_PORT=8086
TEMPLATE_SERVICE_PORT=8087
COMMERCE_SERVICE_PORT=8088
BILLING_USAGE_SERVICE_PORT=8089
REPORTING_SERVICE_PORT=8090
AUDIT_SERVICE_PORT=8091
META_ADAPTER_PORT=8092
WEBHOOK_INGESTOR_PORT=8093
NOTIFICATION_WORKER_PORT=8094
AI_INTELLIGENCE_PORT=8095

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=1500
AI_DETERMINISTIC_FALLBACK=true

# PostgreSQL
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hyfib_wa
POSTGRES_HOST=postgres-primary
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me
REDIS_HOST=redis-master
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://minio:9000

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=hyfib-wa

# Vault
VAULT_DEV_ROOT_TOKEN_ID=change-me
VAULT_ADDR=http://vault:8200
