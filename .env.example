# Global
NODE_ENV=development
LOG_LEVEL=info
PLATFORM_BASE_URL=http://localhost:8080
ALLOWED_WEBHOOK_CIDRS=

# Internal service authentication
# Shared secret required on /internal/* replay and admin endpoints between services.
# Must be set to a non-default value in production: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=

# Platform admin bootstrap (optional)
# When both are set and no user exists with this email, api-gateway creates a
# platform_owner account on startup. Leave unset to skip bootstrap (e.g. after
# the first admin has been created, or when using /auth/register instead).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# API Gateway
API_GATEWAY_PORT=8080
WEBHOOK_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me
WEBHOOK_INGESTOR_URL=http://webhook-ingestor:8093
META_ADAPTER_URL=http://meta-adapter:8092
NOTIFICATION_WORKER_URL=http://notification-worker:8094
AI_INTELLIGENCE_URL=http://ai-intelligence-service:8095

# Authentication (Keycloak OIDC)
# AUTH_ENABLED must be true in production. Set to false ONLY for local dev,
# in which case the gateway trusts x-role/x-tenant-id headers (insecure).
# Dev header role aliases are supported: owner, admin, agent, viewer.
AUTH_ENABLED=true
KEYCLOAK_AUDIENCE=hyfib-platform
# Optional explicit overrides (otherwise derived from KEYCLOAK_BASE_URL + realm):
# KEYCLOAK_ISSUER=
# KEYCLOAK_JWKS_URI=

# WhatsApp
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_BUSINESS_PORTFOLIO_ID=
WHATSAPP_REGISTER_PIN=
# 32-byte key (hex or base64) used to encrypt per-tenant WhatsApp access tokens
# stored on whatsapp_channels. Required only if you register a channel with its
# own token; generate with: openssl rand -hex 32
CHANNEL_ENCRYPTION_KEY=
# Optional defaults for tenant-scoped whatsapp_settings rows.
WHATSAPP_DEFAULT_RETRY_MAX_ATTEMPTS=4
WHATSAPP_DEFAULT_RETRY_BASE_DELAY_MS=500

# Service Ports
META_ADAPTER_PORT=8092
WEBHOOK_INGESTOR_PORT=8093
NOTIFICATION_WORKER_PORT=8094
AI_INTELLIGENCE_PORT=8095
AUDIT_SERVICE_PORT=8096
AUTH_SERVICE_PORT=8097
BILLING_USAGE_SERVICE_PORT=8098
CAMPAIGN_SERVICE_PORT=8099
COMMERCE_SERVICE_PORT=8100
CONTACT_SERVICE_PORT=8101
CONVERSATION_SERVICE_PORT=8102
REPORTING_SERVICE_PORT=8103
TEMPLATE_SERVICE_PORT=8104
TENANT_SERVICE_PORT=8105

# New service URLs (defaults shown; override in docker-compose / k8s)
AUDIT_SERVICE_URL=http://audit-service:8096
AUTH_SERVICE_URL=http://auth-service:8097
BILLING_USAGE_SERVICE_URL=http://billing-usage-service:8098
REPORTING_SERVICE_URL=http://reporting-service:8103
TENANT_SERVICE_URL=http://tenant-service:8105

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=1500
AI_DETERMINISTIC_FALLBACK=true

# PostgreSQL
# POSTGRES_USER is the bootstrap/superuser used for schema init only.
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hyfib_wa
POSTGRES_HOST=postgres-primary
POSTGRES_PORT=5432
# Dedicated NON-superuser role the application connects as, so row-level
# security is enforced. Created automatically by infra/postgres/init/002_app_role.sh.
POSTGRES_APP_USER=hyfib_app
POSTGRES_APP_PASSWORD=change-me
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Redis
REDIS_PASSWORD=change-me
REDIS_HOST=redis-master
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Event transport: "rabbitmq" (default/production) or "memory" (tests/dev only).
EVENT_BUS=rabbitmq
# Optional full override; otherwise derived from the RABBITMQ_* values above.
# RABBITMQ_URL=amqp://platform:change-me@rabbitmq:5672

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://minio:9000

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=hyfib-wa
# Public hostname Keycloak is served on (production overlay, behind the edge proxy).
KEYCLOAK_PUBLIC_HOSTNAME=auth.example.com

# OpenSearch (production overlay enables the security plugin)
OPENSEARCH_ADMIN_PASSWORD=change-me-Str0ng!

# Vault
VAULT_DEV_ROOT_TOKEN_ID=change-me
VAULT_ADDR=http://vault:8200
